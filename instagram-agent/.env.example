# Instagram credentials
INSTAGRAM_USER=tu_usuario
INSTAGRAM_PASS=tu_contraseña

# OpenRouter — get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional: override default model (openrouter/owl-alpha)
LLM_MODEL=openrouter/owl-alpha
# Optional: your site URL for OpenRouter HTTP-Referer header
SITE_URL=https://tudominio.com

# Agent settings
DAILY_LIMIT=20
CRON_HOUR=9
CRON_MINUTE=30

# Set to "true" to run immediately instead of waiting for cron (useful for testing)
RUN_NOW=false

# Web dashboard (optional — leave blank to disable auth)
DASHBOARD_PASSWORD=
